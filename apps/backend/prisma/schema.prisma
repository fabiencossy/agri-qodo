// Prisma schema — Agri Qodo backend
//
// Source de vérité : docs/SPEC_COMPLETE.md §6 (modèle de données central)
// + §11 (lien partenaire M16).
//
// Toutes les entités métier portent `tenantId` (multi-tenant strict).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

// ====================================================================
// Enums
// ====================================================================

enum Canton {
  VD
  GE
  FR
  NE
  JU
  VS
  BE
  ZH
  AG
  SO
  LU
  TG
  SG
  GR
  TI
  BL
  BS
  SH
  AR
  AI
  GL
  NW
  OW
  SZ
  UR
  ZG
}

enum ZoneAgricole {
  ZA // Zone agricole
  ZP // Zone des prairies
  ZM1 // Zone de montagne I
  ZM2 // Zone de montagne II
  ZM3 // Zone de montagne III
  ZM4 // Zone de montagne IV
  ZE // Zone d'estivage
}

enum InterventionType {
  SEMIS
  FUMURE_ORGANIQUE
  FUMURE_MINERALE
  PHYTO
  RECOLTE
  TRAVAIL_DU_SOL
  IRRIGATION
  AUTRE
}

enum ValidationStatus {
  SELF // Saisie par le tenant propriétaire
  PENDING // Saisie par un partenaire, en attente
  VALIDATED // Validée par le propriétaire
  REJECTED // Refusée par le propriétaire
}

// Technique d'épandage pour engrais organiques (lisier, fumier liquide).
// Détermine la perte par volatilisation NH3, voir Guide Agridea 1.18.
enum TechniqueEpandage {
  EPANDEUR_CLASSIQUE // ~30% pertes NH3 — buse, palette, déflecteur
  RAMPE_PENDILLARDE // ~15% — tuyaux pendants, dépose au sol
  TRAINEE_SOUPLE // ~10% — sabots, sous le couvert végétal
  INJECTION // ~5% — directement dans le sol
  FUMIER_SOLIDE // ~25% — épandeur à fumier, incorporation < 4h
}

enum AnimalCategorie {
  // Bovins
  VACHE_LAITIERE
  VACHE_ALLAITANTE
  GENISSE
  VEAU
  TAUREAU
  BOEUF
  AUTRE_BOVIN
  // Ovins
  BREBIS
  AGNEAU
  BELIER
  // Caprins
  CHEVRE
  CABRI
  BOUC
  // Équidés
  CHEVAL_ADULTE
  POULAIN
  ANE
  // Cervidés
  CERF
  DAIM
  // Camélidés
  LAMA
  ALPAGA
  // Porcs (détaillés)
  PORC
  TRUIE
  PORCELET
  // Volailles
  POULET
  POULE_PONDEUSE
  DINDE
  OIE
  CANARD
  PINTADE
  CAILLE
  // Petits élevages
  LAPIN
  ABEILLE_RUCHE
  // Autres
  BISON
  AUTRE
}

enum PartnerLinkStatus {
  PENDING
  ACTIVE
  REVOKED
}

enum PartnerLinkLevel {
  LECTURE // Voit les données mais ne saisit rien
  VALIDATION // Saisit, le propriétaire doit valider
  DIRECT // Saisit directement, sans validation
}

enum UserRole {
  OWNER // Chef d'exploitation
  EMPLOYE // Salarié
  COMPTABLE // Accès lecture/compta
  CONSULTANT // Conseiller (Agridea, fiduciaire)
}

enum RuleSetScope {
  GLOBAL // Template universel (OPD-CH-2026, OPD-CH-2026-BIO, …)
  CANTON // Variante cantonale
  TENANT // Override par exploitation
}

enum ProduitCategorie {
  SEMENCE
  ENGRAIS_MINERAL
  ENGRAIS_ORGANIQUE
  PHYTO
  AUTRE
}

enum ProduitUnite {
  KG // poids sec — standard pour engrais minéraux et semences
  L // litre — engrais liquides, lisier, phytos
  T // tonne — fumier, compost
  M3 // mètre cube — lisier dans certaines régions
  DOSE // doses (semences calibrées, certains phytos)
}

// ====================================================================
// Tenant racine + utilisateurs
// ====================================================================

model Exploitation {
  id           String  @id @default(uuid())
  // Code unique format AQ-{canton}-{ufam}-{token4} — voir §6 spec
  code         String  @unique
  nom          String
  canton       Canton
  numeroUfam   String? @map("numero_ufam") // n° canton/UFAM
  numeroBdta   String? @map("numero_bdta") // n° d'exploitation BDTA / Identitas
  adresse      String?
  npa          String?
  localite     String?
  emailContact String? @map("email_contact")
  telephone    String?

  // ----- Intégration Odoo Enterprise (M6) — config par exploitation -----
  // Une exploitation = une base Odoo dédiée (Odoo.sh ou online.odoo.com).
  // Multi-version simultanée v19+ : la version réelle est résolue à
  // l'authentification via common.version() (cf packages/odoo-client).
  odooUrl             String?   @map("odoo_url")
  odooDb              String?   @map("odoo_db")
  odooUsername        String?   @map("odoo_username")
  // API key chiffrée AES-256-GCM (cf common/crypto). Format : base64url(iv|tag|ciphertext).
  odooApiKeyEncrypted String?   @map("odoo_api_key_encrypted")
  // Version Odoo détectée à la dernière connexion ("19.0+e", "20.0", …).
  odooVersion         String?   @map("odoo_version")
  odooConnectedAt     DateTime? @map("odoo_connected_at")

  // Opt-in annuaire : si true, l'exploitation est trouvable par recherche
  // nom/adresse depuis la page Partenaires d'autres tenants (cf §11 spec).
  // Default false (sécurité + RGPD), basculé via /parametres/exploitation.
  visibleInDirectory Boolean @default(false) @map("visible_in_directory")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users                 User[]
  parcelles             Parcelle[]
  interventionsOwned    Intervention[] @relation("InterventionOwner")
  interventionsAuthored Intervention[] @relation("InterventionAuthor")
  animaux               Animal[]
  lots                  LotAnimal[]
  sortiesSrpa           SortieSrpa[]
  ruleSets              RuleSet[]
  produitsCustom        Produit[]
  partnerLinksOwned     PartnerLink[]  @relation("PartnerLinkOwner")
  partnerLinksPartner   PartnerLink[]  @relation("PartnerLinkPartner")
  travaux               Travail[]      @relation("TravailTenant")
  travauxAsPartenaire   Travail[]      @relation("TravailPartenaire")

  @@map("exploitations")
}

model User {
  id           String    @id @default(uuid())
  email        String
  passwordHash String    @map("password_hash")
  prenom       String
  nom          String
  role         UserRole  @default(OWNER)
  tenantId     String    @map("tenant_id")
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  tenant        Exploitation        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]
  lignesHeure   LigneTravailHeure[]

  // Email partagé : un comptable / conseiller peut avoir un compte sur
  // plusieurs exploitations. L'unicité est sur (email, tenantId).
  @@unique([email, tenantId])
  @@index([email])
  @@index([tenantId])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ====================================================================
// Parcellaire (M1)
// ====================================================================

model Parcelle {
  id                   String                                       @id @default(uuid())
  tenantId             String                                       @map("tenant_id")
  nom                  String
  identifiantCadastral String?                                      @map("identifiant_cadastral")
  surfaceM2            Decimal                                      @map("surface_m2") @db.Decimal(12, 2)
  zone                 ZoneAgricole
  // Couleur de surbrillance sur les cartes — hex 7-char (#RRGGBB).
  // Permet à l'agriculteur de différencier visuellement ses parcelles.
  couleurHex           String?                                      @map("couleur_hex") @db.VarChar(7)
  // Géométrie PostGIS — multipolygone WGS84 (SRID 4326).
  // Prisma ne supporte pas PostGIS nativement, on utilise Unsupported.
  geom                 Unsupported("geometry(MultiPolygon, 4326)")?
  notes                String?
  createdAt            DateTime                                     @default(now()) @map("created_at")
  updatedAt            DateTime                                     @updatedAt @map("updated_at")

  tenant        Exploitation   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cultures      Culture[]
  interventions Intervention[]
  planApports   PlanApport[]
  travaux       Travail[]

  @@index([tenantId])
  @@map("parcelles")
}

// ====================================================================
// Cultures / occupations (M1)
// ====================================================================

model Culture {
  id          String    @id @default(uuid())
  tenantId    String    @map("tenant_id")
  parcelleId  String    @map("parcelle_id")
  espece      String // e.g. "ble_panifiable", "mais_grain", "prairie_temporaire"
  variete     String?
  dateSemis   DateTime? @map("date_semis")
  dateRecolte DateTime? @map("date_recolte") // récolte effective ou prévue
  campagne    Int // année de récolte (2026 = récolte 2026)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  parcelle      Parcelle       @relation(fields: [parcelleId], references: [id], onDelete: Cascade)
  interventions Intervention[]

  @@index([tenantId])
  @@index([parcelleId])
  @@index([campagne])
  @@map("cultures")
}

// ====================================================================
// Plan de fumure prévisionnel (M3v5) — exigence PER : avant la saison,
// l'agriculteur planifie ses apports d'engrais par parcelle pour la
// campagne. Permet de comparer prévu vs réalisé via le carnet.
// ====================================================================

model PlanApport {
  id             String             @id @default(uuid())
  tenantId       String             @map("tenant_id")
  parcelleId     String             @map("parcelle_id")
  campagne       Int // année de récolte de la culture concernée
  datePrevue     DateTime?          @map("date_prevue")
  // Référence catalogue (recommandé). Si null, libellé libre + N/P estimés.
  produitId      String?            @map("produit_id")
  produitLibre   String?            @map("produit_libre") // si pas de produit catalogue
  quantitePrevue Decimal?           @map("quantite_prevue") @db.Decimal(12, 3)
  unite          String?
  // kgN / kgP estimés (calculés depuis produitId×quantite OU saisis manuellement)
  kgNPrevu       Decimal?           @map("kg_n_prevu") @db.Decimal(10, 2)
  kgPPrevu       Decimal?           @map("kg_p_prevu") @db.Decimal(10, 2)
  technique      TechniqueEpandage?
  notes          String?
  // Si l'apport a été réalisé, on pointe vers l'intervention créée à
  // partir de ce plan — relation 1-1.
  interventionId String?            @unique @map("intervention_id")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  parcelle     Parcelle      @relation(fields: [parcelleId], references: [id], onDelete: Cascade)
  produitRef   Produit?      @relation(fields: [produitId], references: [id], onDelete: SetNull)
  intervention Intervention? @relation(fields: [interventionId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([parcelleId])
  @@index([campagne])
  @@map("plan_apports")
}

// ====================================================================
// Carnet des champs / interventions (M2)
// ====================================================================

model Intervention {
  id                  String                                  @id @default(uuid())
  // UUID généré côté client pour idempotence à la sync
  clientUuid          String                                  @unique @map("client_uuid")
  ownerTenantId       String                                  @map("owner_tenant_id")
  authorTenantId      String                                  @map("author_tenant_id") // peut différer de owner si M16
  parcelleId          String                                  @map("parcelle_id")
  type                InterventionType
  dateOperation       DateTime                                @map("date_operation")
  // Référence catalogue (recommandé pour SEMIS, FUMURE, PHYTO).
  // Permet d'autopropulser : SEMIS+produit → Culture, FUMURE+produit → bilan N/P.
  produitId           String?                                 @map("produit_id")
  produit             String? // libellé libre, ou copie du libellé Produit pour traçabilité
  quantite            Decimal?                                @db.Decimal(12, 3)
  // Surface réellement concernée par l'intervention en m². NULL = toute
  // la parcelle (cas par défaut). Si `geom` est fournie, cette surface est
  // recalculée automatiquement via ST_Area.
  surfaceTravailleeM2 Decimal?                                @map("surface_travaillee_m2") @db.Decimal(12, 2)
  // Géométrie de la sous-zone réellement travaillée — polygone WGS84
  // (SRID 4326). NULL = toute la parcelle. Doit être ST_Within `parcelle.geom`
  // (validé côté backend). Permet de représenter spatialement le plan
  // d'assolement : un SEMIS de blé sur la moitié est + un SEMIS d'orge
  // sur la moitié ouest = 2 zones distinctes sur la même parcelle.
  geom                Unsupported("geometry(Polygon, 4326)")? @map("geom")
  unite               String? // "kg", "L", "t", "ha"
  notes               String?
  // Si SEMIS a généré une Culture, on garde le lien pour pouvoir la
  // ré-éditer / supprimer si l'intervention est modifiée.
  cultureId           String?                                 @map("culture_id")
  // Technique d'épandage pour FUMURE_ORGANIQUE — détermine la perte NH3
  // appliquée au calcul du bilan N (Guide Agridea 1.18).
  techniqueEpandage   TechniqueEpandage?                      @map("technique_epandage")
  validationStatus    ValidationStatus                        @default(SELF) @map("validation_status")
  validatedAt         DateTime?                               @map("validated_at")
  rejectedReason      String?                                 @map("rejected_reason")
  createdAt           DateTime                                @default(now()) @map("created_at")

  ownerTenant  Exploitation @relation("InterventionOwner", fields: [ownerTenantId], references: [id], onDelete: Cascade)
  authorTenant Exploitation @relation("InterventionAuthor", fields: [authorTenantId], references: [id], onDelete: Cascade)
  parcelle     Parcelle     @relation(fields: [parcelleId], references: [id], onDelete: Cascade)
  produitRef   Produit?     @relation(fields: [produitId], references: [id], onDelete: SetNull)
  culture      Culture?     @relation(fields: [cultureId], references: [id], onDelete: SetNull)
  planApport   PlanApport? // 1-1 si réalisé depuis un plan

  @@index([ownerTenantId])
  @@index([authorTenantId])
  @@index([parcelleId])
  @@index([dateOperation])
  @@index([validationStatus])
  @@index([produitId])
  @@index([cultureId])
  @@map("interventions")
}

// ====================================================================
// Animaux (M4)
// ====================================================================

model Animal {
  id            String          @id @default(uuid())
  tenantId      String          @map("tenant_id")
  numeroBoucle  String?         @unique @map("numero_boucle") // n° BDTA pour bovins
  nom           String?
  categorie     AnimalCategorie
  sexe          String?         // M | F
  dateNaissance DateTime?       @map("date_naissance")
  dateMort      DateTime?       @map("date_mort") // null = vivant
  usage         String?         // laitiere | allaitante | engraissement | reproduction | jeune | autre
  secteurLabel  String?         @map("secteur_label") // bio | ips | per | conventionnel | suisse-garantie | autre
  statutBvd     String?         @map("statut_bvd") // frei | suspect | positif | vaccine | exempt
  lotId         String?         @map("lot_id")
  isActive      Boolean         @default(true) @map("is_active")
  // Verrou optimiste pour résolution de conflits offline
  version       Int             @default(0)
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  tenant Exploitation @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lot    LotAnimal?   @relation(fields: [lotId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([lotId])
  @@map("animaux")
}

model LotAnimal {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  nom         String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant  Exploitation @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  animaux Animal[]

  @@index([tenantId])
  @@map("lots_animaux")
}

// ====================================================================
// SRPA — Sorties Régulières au Plein Air (M5)
// ====================================================================

model SortieSrpa {
  id            String          @id @default(uuid())
  tenantId      String          @map("tenant_id")
  date          DateTime        @db.Date
  categorie     AnimalCategorie
  nombreAnimaux Int?            @map("nombre_animaux")
  dureeMinutes  Int?            @map("duree_minutes")
  notes         String?
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  tenant Exploitation @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, date, categorie])
  @@index([tenantId])
  @@index([date])
  @@map("sorties_srpa")
}

// ====================================================================
// Lien partenaire entre exploitations (M16)
// Voir §11 spec.
// ====================================================================

// ====================================================================
// Rule Engine — moteurs de calcul configurables par template / canton
// / tenant (cf ADR-003).
// ====================================================================

model RuleSet {
  id            String       @id @default(uuid())
  name          String       @unique
  description   String?
  scope         RuleSetScope
  tenantId      String?      @map("tenant_id")
  canton        Canton?
  parentId      String?      @map("parent_id")
  isActive      Boolean      @default(true) @map("is_active")
  effectiveFrom DateTime     @default(now()) @map("effective_from")
  effectiveTo   DateTime?    @map("effective_to")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  parent   RuleSet?      @relation("RuleSetParent", fields: [parentId], references: [id], onDelete: SetNull)
  children RuleSet[]     @relation("RuleSetParent")
  rules    Rule[]
  tenant   Exploitation? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([scope])
  @@index([tenantId])
  @@map("rule_sets")
}

model Rule {
  id          String   @id @default(uuid())
  ruleSetId   String   @map("rule_set_id")
  key         String
  valueJson   Json     @map("value_json")
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  ruleSet RuleSet @relation(fields: [ruleSetId], references: [id], onDelete: Cascade)

  @@unique([ruleSetId, key])
  @@index([key])
  @@map("rules")
}

// ====================================================================
// Catalogue Produits — semences + engrais + phytos.
//
// Deux scopes coexistent :
//   - GLOBAL (tenantId NULL) : référentiel partagé livré par seed
//     (UFA, Landor, Lonza, …). Read-only pour les utilisateurs.
//   - TENANT (tenantId set) : produits perso d'un agriculteur (variétés
//     spécifiques, mélanges maison, fournisseurs locaux). CRUD libre.
//
// Le `code` est unique global (préfixe `aq-` pour les officiels,
// `t-{tenantId}-…` pour les perso).
// ====================================================================

model Produit {
  id              String           @id @default(uuid())
  tenantId        String?          @map("tenant_id") // null = produit global (read-only)
  categorie       ProduitCategorie
  code            String           @unique
  libelle         String
  fournisseur     String?
  marque          String?
  // Numéro/code officiel (n° swissgranum, n° Mst Agroscope, n° W-OSAV pour
  // les phytos…). Permet la traçabilité réglementaire et la jointure avec
  // les listes officielles lors des futurs imports automatiques.
  numeroOfficiel  String?          @map("numero_officiel")
  // Source du référentiel (ex: "swissgranum 2025", "Agroscope eagff Mst 2025-28",
  // "OSAV PSM 15.04.2026"). Visible utilisateur — exigence OSAV.
  sourceCatalogue String?          @map("source_catalogue")
  // SEMENCE : code espèce qui matche les clés du rule engine
  // (suisse_bilanz.besoin_n_par_culture). Permet à un SEMIS de créer
  // automatiquement la Culture sur la parcelle.
  especeCode      String?          @map("espece_code")
  // ENGRAIS : teneurs N/P/K en kg/100kg de produit (ou kg/100L liquide).
  // Pour les engrais organiques (lisier 4 kg N/m³), utiliser unite = M3
  // ou L et exprimer le taux en kg/100L cohérent (× 1000 pour le m³).
  tauxN           Decimal?         @map("taux_n") @db.Decimal(8, 3)
  tauxP           Decimal?         @map("taux_p") @db.Decimal(8, 3)
  tauxK           Decimal?         @map("taux_k") @db.Decimal(8, 3)
  unite           ProduitUnite     @default(KG)
  // Prix de vente CHF HT par unité — visible des admin uniquement (RBAC :
  // OWNER / COMPTABLE). Les EMPLOYE saisissent le prix sur la ligne de
  // travail si nécessaire, sans voir le prix catalogue ni les marges.
  prixVenteCHF    Decimal?         @map("prix_vente_chf") @db.Decimal(12, 2)
  // Lien Odoo (M6 Phase 2) : product.product.id distant. Renseigné par
  // la sync /api/produits/sync-odoo. Permet le re-sync incrémental
  // (upsert sur (tenantId, odooProductId)).
  odooProductId   Int?             @map("odoo_product_id")
  odooSyncedAt    DateTime?        @map("odoo_synced_at")
  notes           String?
  actif           Boolean          @default(true)
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  tenant        Exploitation?         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  interventions Intervention[]
  planApports   PlanApport[]
  lignesTravail LigneTravailProduit[]

  @@unique([tenantId, odooProductId], name: "tenant_odoo_product_unique")
  @@index([tenantId])
  @@index([categorie])
  @@map("produits")
}

model PartnerLink {
  id              String            @id @default(uuid())
  ownerTenantId   String            @map("owner_tenant_id")
  partnerTenantId String            @map("partner_tenant_id")
  // scope JSON : { parcelles: 'all' | string[], niveau: PartnerLinkLevel }
  scope           Json
  niveau          PartnerLinkLevel
  status          PartnerLinkStatus @default(PENDING)
  grantedAt       DateTime?         @map("granted_at")
  revokedAt       DateTime?         @map("revoked_at")
  createdAt       DateTime          @default(now()) @map("created_at")

  ownerTenant   Exploitation @relation("PartnerLinkOwner", fields: [ownerTenantId], references: [id], onDelete: Cascade)
  partnerTenant Exploitation @relation("PartnerLinkPartner", fields: [partnerTenantId], references: [id], onDelete: Cascade)

  @@unique([ownerTenantId, partnerTenantId])
  @@index([status])
  @@map("partner_links")
}

// ====================================================================
// Travaux facturables (M6 PR-D) — modèle unifié produits + heures
// ====================================================================
//
// Un Travail = un événement complet (mission, prestation, opération
// interne) qui regroupe en un seul endroit :
//   - les PRODUITS consommés (semences, phytos, fournitures…)
//   - les HEURES de travail des employés (timesheet)
//
// Ce design évite la double saisie (cf project_agri_qodo_travaux_timesheet
// en mémoire). Pour la facturation Odoo : 1 sale.order avec lignes
// produits ET lignes services horaires + N analytic lines pour le
// timesheet comptable (PR-E à venir).

enum TravailStatut {
  DRAFT     // brouillon, l'agriculteur saisit
  VALIDATED // validé, prêt à facturer
  INVOICED  // poussé vers Odoo (sale.order créé)
  CANCELLED
}

model Travail {
  id           String        @id @default(uuid())
  tenantId     String        @map("tenant_id")
  // Client/partenaire pour qui le travail a été fait. Null = travail
  // interne à l'exploitation (sans facturation client).
  partenaireId String?       @map("partenaire_id")
  // Parcelle concernée (optionnel — un travail peut être hors parcelle,
  // ex maintenance bâtiment, transport).
  parcelleId   String?       @map("parcelle_id")
  // Référence libre (ex "Récolte champ Loup"), affichée dans les listes.
  titre        String
  date         DateTime
  dateDebut    DateTime?     @map("date_debut")
  dateFin      DateTime?     @map("date_fin")
  // Travail interne : pas facturable, pas exporté vers Odoo. Permet de
  // pointer du temps "personnel" (entretien tracteur, formation) sans
  // créer de devis client.
  interne      Boolean       @default(false)
  statut       TravailStatut @default(DRAFT)
  notes        String?
  // Une fois poussé vers Odoo, on garde la trace du sale.order créé pour
  // pouvoir réconcilier (et bloquer la modification).
  odooSaleOrderId Int?       @map("odoo_sale_order_id")
  invoicedAt   DateTime?     @map("invoiced_at")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  tenant     Exploitation  @relation("TravailTenant", fields: [tenantId], references: [id], onDelete: Cascade)
  partenaire Exploitation? @relation("TravailPartenaire", fields: [partenaireId], references: [id], onDelete: SetNull)
  parcelle   Parcelle?     @relation(fields: [parcelleId], references: [id], onDelete: SetNull)

  lignesProduit LigneTravailProduit[]
  lignesHeure   LigneTravailHeure[]

  @@index([tenantId])
  @@index([partenaireId])
  @@index([parcelleId])
  @@index([statut])
  @@index([date])
  @@map("travaux")
}

model LigneTravailProduit {
  id        String   @id @default(uuid())
  travailId String   @map("travail_id")
  // Référence catalogue (recommandé). Null pour libellé libre.
  produitId String?  @map("produit_id")
  // Libellé affiché (auto-rempli depuis le produit si choisi).
  libelle   String
  quantite  Decimal  @db.Decimal(12, 3)
  unite     String   @default("kg")
  // Prix unitaire CHF HT. Null = ligne non facturable (consommable interne).
  prixUnitaireCHF Decimal? @map("prix_unitaire_chf") @db.Decimal(12, 2)
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")

  travail Travail  @relation(fields: [travailId], references: [id], onDelete: Cascade)
  produit Produit? @relation(fields: [produitId], references: [id], onDelete: SetNull)

  @@index([travailId])
  @@index([produitId])
  @@map("travail_lignes_produit")
}

model LigneTravailHeure {
  id        String  @id @default(uuid())
  travailId String  @map("travail_id")
  // Employé qui a effectué les heures. Référence User (= membership tenant).
  userId    String  @map("user_id")
  // Heures début / fin (optionnel). Si renseignés, dureeMinutes est calculée
  // automatiquement. Sert aussi pour le lien avec la présence (qui a
  // travaillé quand) — cf future intégration timesheet/attendance Odoo.
  heureDebut DateTime? @map("heure_debut")
  heureFin   DateTime? @map("heure_fin")
  // Durée en minutes — plus précis qu'heures décimales pour la saisie au
  // smartphone (pause = 30 min, déplacement = 45 min, etc.).
  dureeMinutes Int  @map("duree_minutes")
  // Taux horaire CHF HT. Null = ligne non facturable (heures internes).
  tauxHoraireCHF Decimal? @map("taux_horaire_chf") @db.Decimal(12, 2)
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")

  travail Travail @relation(fields: [travailId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([travailId])
  @@index([userId])
  @@map("travail_lignes_heure")
}
