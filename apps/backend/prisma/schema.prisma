// Prisma schema — Agri Qodo backend
//
// Source de vérité : docs/SPEC_COMPLETE.md §6 (modèle de données central)
// + §11 (lien partenaire M16).
//
// Toutes les entités métier portent `tenantId` (multi-tenant strict).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

// ====================================================================
// Enums
// ====================================================================

enum Canton {
  VD
  GE
  FR
  NE
  JU
  VS
  BE
  ZH
  AG
  SO
  LU
  TG
  SG
  GR
  TI
  BL
  BS
  SH
  AR
  AI
  GL
  NW
  OW
  SZ
  UR
  ZG
}

enum ZoneAgricole {
  ZA // Zone agricole
  ZP // Zone des prairies
  ZM1 // Zone de montagne I
  ZM2 // Zone de montagne II
  ZM3 // Zone de montagne III
  ZM4 // Zone de montagne IV
  ZE // Zone d'estivage
}

enum InterventionType {
  SEMIS
  FUMURE_ORGANIQUE
  FUMURE_MINERALE
  PHYTO
  RECOLTE
  TRAVAIL_DU_SOL
  IRRIGATION
  AUTRE
}

enum ValidationStatus {
  SELF // Saisie par le tenant propriétaire
  PENDING // Saisie par un partenaire, en attente
  VALIDATED // Validée par le propriétaire
  REJECTED // Refusée par le propriétaire
}

// Technique d'épandage pour engrais organiques (lisier, fumier liquide).
// Détermine la perte par volatilisation NH3, voir Guide Agridea 1.18.
enum TechniqueEpandage {
  EPANDEUR_CLASSIQUE // ~30% pertes NH3 — buse, palette, déflecteur
  RAMPE_PENDILLARDE // ~15% — tuyaux pendants, dépose au sol
  TRAINEE_SOUPLE // ~10% — sabots, sous le couvert végétal
  INJECTION // ~5% — directement dans le sol
  FUMIER_SOLIDE // ~25% — épandeur à fumier, incorporation < 4h
}

enum AnimalCategorie {
  // Bovins
  VACHE_LAITIERE
  VACHE_ALLAITANTE
  GENISSE
  VEAU
  TAUREAU
  BOEUF
  AUTRE_BOVIN
  // Ovins
  BREBIS
  AGNEAU
  BELIER
  // Caprins
  CHEVRE
  CABRI
  BOUC
  // Équidés
  CHEVAL_ADULTE
  POULAIN
  ANE
  // Cervidés
  CERF
  DAIM
  // Camélidés
  LAMA
  ALPAGA
  // Porcs (détaillés)
  PORC
  TRUIE
  PORCELET
  // Volailles
  POULET
  POULE_PONDEUSE
  DINDE
  OIE
  CANARD
  PINTADE
  CAILLE
  // Petits élevages
  LAPIN
  ABEILLE_RUCHE
  // Autres
  BISON
  AUTRE
}

enum PartnerLinkStatus {
  PENDING
  ACTIVE
  REVOKED
}

enum PartnerLinkLevel {
  LECTURE // Voit les données mais ne saisit rien
  VALIDATION // Saisit, le propriétaire doit valider
  DIRECT // Saisit directement, sans validation
}

enum UserRole {
  OWNER // Chef d'exploitation
  EMPLOYE // Salarié
  COMPTABLE // Accès lecture/compta
  CONSULTANT // Conseiller (Agridea, fiduciaire)
}

enum RuleSetScope {
  GLOBAL // Template universel (OPD-CH-2026, OPD-CH-2026-BIO, …)
  CANTON // Variante cantonale
  TENANT // Override par exploitation
}

enum ProduitCategorie {
  SEMENCE
  ENGRAIS_MINERAL
  ENGRAIS_ORGANIQUE
  PHYTO
  AUTRE
}

enum ProduitUnite {
  KG // poids sec — standard pour engrais minéraux et semences
  L // litre — engrais liquides, lisier, phytos
  T // tonne — fumier, compost
  M3 // mètre cube — lisier dans certaines régions
  DOSE // doses (semences calibrées, certains phytos)
}

// Matériel = prestation/opération facturable rendue sur le terrain
// (≠ Produit qui est un intrant consommé). Exemples : labour, semis,
// pulvérisation, ensilage, presse à balles. Mappé sur un product.product
// Odoo de type "service" pour la facturation à l'hectare/m³/heure.
enum MaterielCategorie {
  TRAVAIL_DU_SOL // charrue, herse, vibroculteur, déchaumeuse
  SEMIS // semoir céréale, semoir mono-graine, semoir direct
  FERTILISATION // épandeur engrais, tonne à lisier, distributeur
  PROTECTION // pulvérisateur, pompe à traiter, désherbeur méca
  RECOLTE // moissonneuse, ensileuse, presse, autochargeuse, arracheuse
  IRRIGATION // enrouleur, rampe, goutte-à-goutte
  TRANSPORT // benne, plateau, semi
  AUTRE
}

enum MaterielUnite {
  HA // à l'hectare (le plus courant pour les travaux du sol)
  M3 // au m³ (transport, ensilage)
  T // à la tonne (récolte, transport)
  H // à l'heure (location matériel)
  FORFAIT // au forfait (déplacement, mise en route)
}

// ====================================================================
// Tenant racine + utilisateurs
// ====================================================================

model Exploitation {
  id           String  @id @default(uuid())
  // Code unique format AQ-{canton}-{ufam}-{token4} — voir §6 spec
  code         String  @unique
  nom          String
  canton       Canton
  numeroUfam   String? @map("numero_ufam") // n° canton/UFAM
  numeroBdta   String? @map("numero_bdta") // n° d'exploitation BDTA / Identitas
  adresse      String?
  npa          String?
  localite     String?
  emailContact String? @map("email_contact")
  telephone    String?

  // ----- Intégration Odoo Enterprise (M6) — config par exploitation -----
  // Une exploitation = une base Odoo dédiée (Odoo.sh ou online.odoo.com).
  // Multi-version simultanée v19+ : la version réelle est résolue à
  // l'authentification via common.version() (cf packages/odoo-client).
  odooUrl             String?   @map("odoo_url")
  odooDb              String?   @map("odoo_db")
  odooUsername        String?   @map("odoo_username")
  // API key chiffrée AES-256-GCM (cf common/crypto). Format : base64url(iv|tag|ciphertext).
  odooApiKeyEncrypted String?   @map("odoo_api_key_encrypted")
  // Version Odoo détectée à la dernière connexion ("19.0+e", "20.0", …).
  odooVersion         String?   @map("odoo_version")
  odooConnectedAt     DateTime? @map("odoo_connected_at")

  // Opt-in annuaire : si true, l'exploitation est trouvable par recherche
  // nom/adresse depuis la page Partenaires d'autres tenants (cf §11 spec).
  // Default false (sécurité + RGPD), basculé via /parametres/exploitation.
  visibleInDirectory Boolean @default(false) @map("visible_in_directory")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users                 User[]
  parcelles             Parcelle[]
  interventionsOwned    Intervention[] @relation("InterventionOwner")
  interventionsAuthored Intervention[] @relation("InterventionAuthor")
  animaux               Animal[]
  lots                  LotAnimal[]
  sortiesSrpa           SortieSrpa[]
  ruleSets              RuleSet[]
  produitsCustom        Produit[]
  materiels             Materiel[]
  partnerLinksOwned     PartnerLink[]  @relation("PartnerLinkOwner")
  partnerLinksPartner   PartnerLink[]  @relation("PartnerLinkPartner")
  travaux               Travail[]      @relation("TravailTenant")
  travauxAsPartenaire   Travail[]      @relation("TravailPartenaire")
  presences             Presence[]
  editHistory           EditHistory[]
  projets               Projet[]

  // ----- Settings tenant (cf §C2) — par défaut configuration "classique"
  // (intervention liée à une parcelle, pas de projet par défaut). L'OWNER
  // peut switcher dans Paramètres → Exploitation.
  /// Si true, les interventions du carnet des champs sont liées à un
  /// Projet plutôt qu'à une Parcelle. Permet de regrouper les opérations
  /// par "type de travaux" (ex: Récolte 2026, Assolement bio…) au lieu
  /// de la géographie.
  noterTempsParProjet   Boolean @default(false) @map("noter_temps_par_projet")
  /// Projet pré-sélectionné dans le formulaire Travaux pour tiers.
  /// Pratique pour les ETA qui travaillent sous une seule étiquette.
  defaultProjetTravauxTiersId String? @map("default_projet_travaux_tiers_id")
  defaultProjetTravauxTiers   Projet? @relation("DefaultProjetTravauxTiers", fields: [defaultProjetTravauxTiersId], references: [id], onDelete: SetNull)
  /// Affichage des champs heures par onglet (PRD fusion v0.2 §3.2).
  /// 3 booléens granulaires — true = affiché, false = caché. Permet à
  /// chaque exploitation de configurer la saisie selon ses usages réels
  /// (ex : ne saisir les heures que sur Travail pour tiers pour facturer
  /// le client, mais pas sur Carnet ni Travail interne).
  heuresVisiblesCarnet         Boolean @default(true) @map("heures_visibles_carnet")
  heuresVisiblesTravauxTiers   Boolean @default(true) @map("heures_visibles_travaux_tiers")
  heuresVisiblesTravauxInterne Boolean @default(true) @map("heures_visibles_travaux_interne")
  /// Projet où s'imputent les heures saisies par onglet (PRD fusion v0.2 §3.2 +
  /// décision 2026-05-05). Obligatoire dès que le toggle correspondant est ON
  /// — validé en service. Null seulement si le toggle est OFF.
  projetHeuresCarnetId         String? @map("projet_heures_carnet_id")
  projetHeuresCarnet           Projet? @relation("ProjetHeuresCarnet", fields: [projetHeuresCarnetId], references: [id], onDelete: SetNull)
  projetHeuresTravauxTiersId   String? @map("projet_heures_travaux_tiers_id")
  projetHeuresTravauxTiers     Projet? @relation("ProjetHeuresTravauxTiers", fields: [projetHeuresTravauxTiersId], references: [id], onDelete: SetNull)
  projetHeuresTravauxInterneId String? @map("projet_heures_travaux_interne_id")
  projetHeuresTravauxInterne   Projet? @relation("ProjetHeuresTravauxInterne", fields: [projetHeuresTravauxInterneId], references: [id], onDelete: SetNull)
  /// Projets Odoo (`project.project`) cibles pour les 3 cas du PRD prestations
  /// v0.3 §2. IDs Odoo (Int) — pas de FK vers une table locale puisque la
  /// vérité vit côté Odoo. Configurés dans /parametres/exploitation par un
  /// sélecteur qui liste GET /api/odoo/projects.
  odooProjectIdTravauxTiers   Int? @map("odoo_project_id_travaux_tiers")
  odooProjectIdCarnetTiers    Int? @map("odoo_project_id_carnet_tiers")
  odooProjectIdCarnetInterne  Int? @map("odoo_project_id_carnet_interne")

  @@map("exploitations")
}

// ====================================================================
// Projets — regroupement libre d'opérations (interventions ou travaux)
// par étiquette métier choisie par l'agriculteur.
// ====================================================================

enum ProjetType {
  INTERVENTION   // Pour les interventions du carnet (mode "noter par projet")
  TRAVAUX_TIERS  // Pour les travaux ETA / facturables
  INTERNE        // Pour les travaux internes (entretien, formation…)
  AUTRE
}

/// Étiquette de regroupement d'opérations. L'agriculteur choisit lui-même
/// le découpage (ex: "Récolte 2026", "Chantier Bruhlart toiture",
/// "Entretien matériel"). Sert de filtre/groupe dans les listes et
/// éventuellement de bucket Odoo (project.project) à terme.
model Projet {
  id          String      @id @default(uuid())
  tenantId    String      @map("tenant_id")
  nom         String      @db.VarChar(120)
  description String?
  type        ProjetType  @default(AUTRE)
  /// Couleur d'affichage (hex), pour distinguer visuellement.
  couleurHex  String?     @map("couleur_hex")
  /// Projet archivé : caché des sélecteurs mais conservé pour historique.
  archive     Boolean     @default(false)
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  tenant Exploitation @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  defaultForTenants                Exploitation[] @relation("DefaultProjetTravauxTiers")
  defaultForHeuresCarnet           Exploitation[] @relation("ProjetHeuresCarnet")
  defaultForHeuresTravauxTiers     Exploitation[] @relation("ProjetHeuresTravauxTiers")
  defaultForHeuresTravauxInterne   Exploitation[] @relation("ProjetHeuresTravauxInterne")
  travaux                          Travail[]      @relation("TravailProjet")

  @@unique([tenantId, nom])
  @@index([tenantId, archive])
  @@map("projets")
}

model User {
  id           String    @id @default(uuid())
  email        String
  passwordHash String    @map("password_hash")
  prenom       String
  nom          String
  role         UserRole  @default(OWNER)
  tenantId     String    @map("tenant_id")
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  // Profil utilisateur — section "Mon compte" sur /profil.
  telephone    String?
  // URL publique de l'avatar (stockage statique côté backend dans
  // /uploads/avatars/{userId}.{ext}, servi via /api/uploads/avatars/...).
  // Null = avatar par défaut (initiales prenom+nom).
  avatarUrl    String?   @map("avatar_url")
  // Préférences UI : langue (fr|de|it|en), thème (light|dark|system),
  // format date. Stocké en JSON pour flexibilité MVP — schéma fixe à
  // figer plus tard avec une vraie table si on a beaucoup de prefs.
  preferences  Json?
  // Vérification email — null tant que l'utilisateur n'a pas cliqué sur
  // le lien de vérification reçu au signup. À utiliser pour gater
  // certaines actions sensibles (push Odoo, invitation partenaire) plus
  // tard. Pour l'instant on n'aborte rien si null, mais on affiche un
  // banner UI "Vérifie ton email".
  emailVerifiedAt DateTime? @map("email_verified_at")
  // Consentement CGU + politique de confidentialité (nFADP/RGPD).
  // null = pas accepté (cas users créés avant la mise en place).
  // version = identifiant de la version acceptée (ex "2026-04-30") —
  // re-prompt si nouvelle version publiée.
  cguAcceptedAt   DateTime? @map("cgu_accepted_at")
  cguVersion      String?   @map("cgu_version")
  /// ID hr.employee Odoo associé à cet utilisateur. Utilisé pour
  /// pousser les heures saisies dans Agri Qodo en account.analytic.line
  /// (feuilles de temps Odoo) sous l'employé correspondant. Null = pas
  /// encore mappé, les heures restent sur le tenant générique.
  odooEmployeeId  Int?      @map("odoo_employee_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  tenant                  Exploitation             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  refreshTokens           RefreshToken[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  lignesHeure             LigneTravailHeure[]
  presences               Presence[]
  editHistory             EditHistory[]
  // Sprint 2 fusion-interventions : assignation planning. L'employé qui
  // doit réaliser un travail planifié à l'avance.
  travauxAssignes         Travail[]                @relation("TravailAssignedUser")
  interventionsAssignees  Intervention[]           @relation("InterventionAssignedUser")

  // Email partagé : un comptable / conseiller peut avoir un compte sur
  // plusieurs exploitations. L'unicité est sur (email, tenantId).
  @@unique([email, tenantId])
  @@index([email])
  @@index([tenantId])
  @@map("users")
}

model EmailVerificationToken {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  // Hash SHA-256 du token. Brut envoyé par mail uniquement.
  tokenHash  String    @unique @map("token_hash")
  // Expire long (7j) — l'utilisateur peut prendre son temps.
  expiresAt  DateTime  @map("expires_at")
  usedAt     DateTime? @map("used_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  // Hash SHA-256 du token (le token brut est envoyé par mail uniquement,
  // jamais persisté en clair). Lookup via hash au moment du confirm.
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  // Date d'utilisation — un token consommé ne peut plus servir.
  usedAt     DateTime? @map("used_at")
  // Trace IP + UA pour audit minimal.
  requestIp  String?   @map("request_ip")
  requestUa  String?   @map("request_ua")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ====================================================================
// Parcellaire (M1)
// ====================================================================

model Parcelle {
  id                   String                                       @id @default(uuid())
  tenantId             String                                       @map("tenant_id")
  nom                  String
  identifiantCadastral String?                                      @map("identifiant_cadastral")
  surfaceM2            Decimal                                      @map("surface_m2") @db.Decimal(12, 2)
  /// Point GPS du centre de la parcelle (création rapide depuis le
  /// formulaire d'intervention pour les clients Odoo "seuls" qui n'ont
  /// pas dessiné leurs parcelles). Optionnel — à terme remplacé par le
  /// `geom` MultiPolygon. WGS84 (SRID 4326).
  centreLat            Float?                                       @map("centre_lat")
  centreLng            Float?                                       @map("centre_lng")
  /// Si la parcelle est "chez un client Odoo non-partenaire" (créée
  /// rapidement depuis le sélecteur), on mémorise l'ID res.partner
  /// Odoo pour pouvoir refiltrer la liste quand l'utilisateur
  /// resélectionne le même client. tenantId reste celui du
  /// prestataire (= moi qui exécute le travail).
  odooPartnerId        Int?                                         @map("odoo_partner_id")
  zone                 ZoneAgricole
  /// Culture en place / statut initial — code espèce libre (réutilise
  /// les clés `besoinNParCulture` du domain : prairie_permanente,
  /// ble_panifiable, …). Sert de fallback Suisse-Bilanz quand aucune
  /// Culture n'a été saisie pour la campagne — utile pour les prairies
  /// permanentes qui restent d'année en année.
  cultureActuelle      String?                                      @map("culture_actuelle")
  // Couleur de surbrillance sur les cartes — hex 7-char (#RRGGBB).
  // Permet à l'agriculteur de différencier visuellement ses parcelles.
  couleurHex           String?                                      @map("couleur_hex") @db.VarChar(7)
  // Géométrie PostGIS — multipolygone WGS84 (SRID 4326).
  // Prisma ne supporte pas PostGIS nativement, on utilise Unsupported.
  geom                 Unsupported("geometry(MultiPolygon, 4326)")?
  notes                String?
  createdAt            DateTime                                     @default(now()) @map("created_at")
  updatedAt            DateTime                                     @updatedAt @map("updated_at")

  tenant        Exploitation   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cultures      Culture[]
  interventions Intervention[]
  planApports   PlanApport[]
  travaux       Travail[]

  @@index([tenantId])
  @@map("parcelles")
}

// ====================================================================
// Cultures / occupations (M1)
// ====================================================================

model Culture {
  id          String    @id @default(uuid())
  tenantId    String    @map("tenant_id")
  parcelleId  String    @map("parcelle_id")
  espece      String // e.g. "ble_panifiable", "mais_grain", "prairie_temporaire"
  variete     String?
  dateSemis   DateTime? @map("date_semis")
  dateRecolte DateTime? @map("date_recolte") // récolte effective ou prévue
  campagne    Int // année de récolte (2026 = récolte 2026)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  parcelle      Parcelle       @relation(fields: [parcelleId], references: [id], onDelete: Cascade)
  interventions Intervention[]

  @@index([tenantId])
  @@index([parcelleId])
  @@index([campagne])
  @@map("cultures")
}

// ====================================================================
// Plan de fumure prévisionnel (M3v5) — exigence PER : avant la saison,
// l'agriculteur planifie ses apports d'engrais par parcelle pour la
// campagne. Permet de comparer prévu vs réalisé via le carnet.
// ====================================================================

model PlanApport {
  id             String             @id @default(uuid())
  tenantId       String             @map("tenant_id")
  parcelleId     String             @map("parcelle_id")
  campagne       Int // année de récolte de la culture concernée
  datePrevue     DateTime?          @map("date_prevue")
  // Référence catalogue (recommandé). Si null, libellé libre + N/P estimés.
  produitId      String?            @map("produit_id")
  produitLibre   String?            @map("produit_libre") // si pas de produit catalogue
  quantitePrevue Decimal?           @map("quantite_prevue") @db.Decimal(12, 3)
  unite          String?
  // kgN / kgP estimés (calculés depuis produitId×quantite OU saisis manuellement)
  kgNPrevu       Decimal?           @map("kg_n_prevu") @db.Decimal(10, 2)
  kgPPrevu       Decimal?           @map("kg_p_prevu") @db.Decimal(10, 2)
  technique      TechniqueEpandage?
  notes          String?
  // Si l'apport a été réalisé, on pointe vers l'intervention créée à
  // partir de ce plan — relation 1-1.
  interventionId String?            @unique @map("intervention_id")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  parcelle     Parcelle      @relation(fields: [parcelleId], references: [id], onDelete: Cascade)
  produitRef   Produit?      @relation(fields: [produitId], references: [id], onDelete: SetNull)
  intervention Intervention? @relation(fields: [interventionId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([parcelleId])
  @@index([campagne])
  @@map("plan_apports")
}

// ====================================================================
// Carnet des champs / interventions (M2)
// ====================================================================

model Intervention {
  id                  String                                  @id @default(uuid())
  // UUID généré côté client pour idempotence à la sync
  clientUuid          String                                  @unique @map("client_uuid")
  ownerTenantId       String                                  @map("owner_tenant_id")
  authorTenantId      String                                  @map("author_tenant_id") // peut différer de owner si M16
  parcelleId          String                                  @map("parcelle_id")
  type                InterventionType
  dateOperation       DateTime                                @map("date_operation")
  // Référence catalogue (recommandé pour SEMIS, FUMURE, PHYTO).
  // Permet d'autopropulser : SEMIS+produit → Culture, FUMURE+produit → bilan N/P.
  produitId           String?                                 @map("produit_id")
  produit             String? // libellé libre, ou copie du libellé Produit pour traçabilité
  // Matériel/outil utilisé pour l'opération (charrue, semoir, pulvé, ensileuse…).
  // En cas B (intervention sur parcelle d'un partenaire), sert aussi de
  // ligne sale.order Odoo facturée par le prestataire.
  materielId          String?                                 @map("materiel_id")
  // Surface effective travaillée en hectares — utilisée comme quantité
  // facturée quand `materiel.unite = HA`. Calculée auto depuis `geom`
  // (ST_Area / 10000) ou depuis `parcelle.surface` si geom = null.
  surfaceHa           Decimal?                                @map("surface_ha") @db.Decimal(10, 4)
  // Cas B (parcelle d'un partenaire) : lien 1-1 vers le Travail créé chez
  // le prestataire pour porter le sale.order Odoo. Permet de re-pousser /
  // annuler / modifier en cascade. Null en cas A (parcelle perso).
  linkedTravailId     String?                                 @unique @map("linked_travail_id")
  // Cas A (parcelle perso) : project.task Odoo créé automatiquement pour
  // tracer l'intervention sans facturation. Null si Odoo non configuré
  // ou push échoué (best-effort). En cas B, c'est `linkedTravail.odooSaleOrderId`
  // qui prend le relais (vraie commande facturable).
  odooTaskId          Int?                                    @map("odoo_task_id")
  odooTaskPushedAt    DateTime?                               @map("odoo_task_pushed_at")
  // Rendement à l'hectare (optionnel) — typiquement saisi sur RECOLTE :
  // 80 q/ha de blé, 12 t/ha de maïs, 45 t/ha pommes de terre. L'unité
  // suit `unite` (kg, t, q, dose…). Sert aux statistiques agronomiques
  // multi-année (suivi de productivité par parcelle).
  rendementParHa      Decimal?                                @map("rendement_par_ha") @db.Decimal(12, 3)
  quantite            Decimal?                                @db.Decimal(12, 3)
  // Surface réellement concernée par l'intervention en m². NULL = toute
  // la parcelle (cas par défaut). Si `geom` est fournie, cette surface est
  // recalculée automatiquement via ST_Area.
  surfaceTravailleeM2 Decimal?                                @map("surface_travaillee_m2") @db.Decimal(12, 2)
  // Géométrie de la sous-zone réellement travaillée — polygone WGS84
  // (SRID 4326). NULL = toute la parcelle. Doit être ST_Within `parcelle.geom`
  // (validé côté backend). Permet de représenter spatialement le plan
  // d'assolement : un SEMIS de blé sur la moitié est + un SEMIS d'orge
  // sur la moitié ouest = 2 zones distinctes sur la même parcelle.
  geom                Unsupported("geometry(Polygon, 4326)")? @map("geom")
  unite               String? // "kg", "L", "t", "ha"
  notes               String?
  // Si SEMIS a généré une Culture, on garde le lien pour pouvoir la
  // ré-éditer / supprimer si l'intervention est modifiée.
  cultureId           String?                                 @map("culture_id")
  // Technique d'épandage pour FUMURE_ORGANIQUE — détermine la perte NH3
  // appliquée au calcul du bilan N (Guide Agridea 1.18).
  techniqueEpandage   TechniqueEpandage?                      @map("technique_epandage")
  validationStatus    ValidationStatus                        @default(SELF) @map("validation_status")
  validatedAt         DateTime?                               @map("validated_at")
  rejectedReason      String?                                 @map("rejected_reason")
  // Champs personnalisés tenant (PRD fusion v0.2 §4 q4) — JSON libre pour
  // permettre des extensions sans migration. UI à venir Sprint ultérieur.
  customFields        Json?                                   @map("custom_fields")
  // Heures passées sur l'intervention (mono-utilisateur — l'auteur).
  // Affichage conditionné par Exploitation.heuresVisiblesCarnet.
  // Soit dureeMinutes seul, soit heureDebut+heureFin (auto-calc dureeMinutes).
  heureDebut          DateTime?                               @map("heure_debut")
  heureFin            DateTime?                               @map("heure_fin")
  dureeMinutes        Int?                                    @map("duree_minutes")
  // Sprint 2 fusion-interventions — Planning. Si datePrevue est
  // renseignée et que dateOperation est postérieure (ou égale), l'item
  // apparaît dans /planning. assignedToUserId désigne l'employé en
  // charge. Une fois la saisie faite, validationStatus passe en
  // SELF/PENDING comme avant.
  datePrevue          DateTime?                               @map("date_prevue")
  assignedToUserId    String?                                 @map("assigned_to_user_id")
  createdAt           DateTime                                @default(now()) @map("created_at")

  ownerTenant   Exploitation @relation("InterventionOwner", fields: [ownerTenantId], references: [id], onDelete: Cascade)
  assignedTo    User?        @relation("InterventionAssignedUser", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  authorTenant  Exploitation @relation("InterventionAuthor", fields: [authorTenantId], references: [id], onDelete: Cascade)
  parcelle      Parcelle     @relation(fields: [parcelleId], references: [id], onDelete: Cascade)
  produitRef    Produit?     @relation(fields: [produitId], references: [id], onDelete: SetNull)
  materielRef   Materiel?    @relation(fields: [materielId], references: [id], onDelete: SetNull)
  culture       Culture?     @relation(fields: [cultureId], references: [id], onDelete: SetNull)
  linkedTravail Travail?     @relation("InterventionTravailLink", fields: [linkedTravailId], references: [id], onDelete: SetNull)
  planApport    PlanApport? // 1-1 si réalisé depuis un plan

  @@index([ownerTenantId])
  @@index([authorTenantId])
  @@index([parcelleId])
  @@index([dateOperation])
  @@index([validationStatus])
  @@index([produitId])
  @@index([materielId])
  @@index([cultureId])
  @@map("interventions")
}

// ====================================================================
// Animaux (M4)
// ====================================================================

model Animal {
  id            String          @id @default(uuid())
  tenantId      String          @map("tenant_id")
  numeroBoucle  String?         @unique @map("numero_boucle") // n° BDTA pour bovins
  nom           String?
  categorie     AnimalCategorie
  sexe          String?         // M | F
  dateNaissance DateTime?       @map("date_naissance")
  dateMort      DateTime?       @map("date_mort") // null = vivant
  usage         String?         // laitiere | allaitante | engraissement | reproduction | jeune | autre
  secteurLabel  String?         @map("secteur_label") // bio | ips | per | conventionnel | suisse-garantie | autre
  statutBvd     String?         @map("statut_bvd") // frei | suspect | positif | vaccine | exempt
  lotId         String?         @map("lot_id")
  isActive      Boolean         @default(true) @map("is_active")
  // Verrou optimiste pour résolution de conflits offline
  version       Int             @default(0)
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  tenant Exploitation @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lot    LotAnimal?   @relation(fields: [lotId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([lotId])
  @@map("animaux")
}

model LotAnimal {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  nom         String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant  Exploitation @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  animaux Animal[]

  @@index([tenantId])
  @@map("lots_animaux")
}

// ====================================================================
// SRPA — Sorties Régulières au Plein Air (M5)
// ====================================================================

model SortieSrpa {
  id            String          @id @default(uuid())
  tenantId      String          @map("tenant_id")
  date          DateTime        @db.Date
  categorie     AnimalCategorie
  nombreAnimaux Int?            @map("nombre_animaux")
  dureeMinutes  Int?            @map("duree_minutes")
  notes         String?
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  tenant Exploitation @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, date, categorie])
  @@index([tenantId])
  @@index([date])
  @@map("sorties_srpa")
}

// ====================================================================
// Lien partenaire entre exploitations (M16)
// Voir §11 spec.
// ====================================================================

// ====================================================================
// Rule Engine — moteurs de calcul configurables par template / canton
// / tenant (cf ADR-003).
// ====================================================================

model RuleSet {
  id            String       @id @default(uuid())
  name          String       @unique
  description   String?
  scope         RuleSetScope
  tenantId      String?      @map("tenant_id")
  canton        Canton?
  parentId      String?      @map("parent_id")
  isActive      Boolean      @default(true) @map("is_active")
  effectiveFrom DateTime     @default(now()) @map("effective_from")
  effectiveTo   DateTime?    @map("effective_to")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  parent   RuleSet?      @relation("RuleSetParent", fields: [parentId], references: [id], onDelete: SetNull)
  children RuleSet[]     @relation("RuleSetParent")
  rules    Rule[]
  tenant   Exploitation? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([scope])
  @@index([tenantId])
  @@map("rule_sets")
}

model Rule {
  id          String   @id @default(uuid())
  ruleSetId   String   @map("rule_set_id")
  key         String
  valueJson   Json     @map("value_json")
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  ruleSet RuleSet @relation(fields: [ruleSetId], references: [id], onDelete: Cascade)

  @@unique([ruleSetId, key])
  @@index([key])
  @@map("rules")
}

// ====================================================================
// Catalogue Produits — semences + engrais + phytos.
//
// Deux scopes coexistent :
//   - GLOBAL (tenantId NULL) : référentiel partagé livré par seed
//     (UFA, Landor, Lonza, …). Read-only pour les utilisateurs.
//   - TENANT (tenantId set) : produits perso d'un agriculteur (variétés
//     spécifiques, mélanges maison, fournisseurs locaux). CRUD libre.
//
// Le `code` est unique global (préfixe `aq-` pour les officiels,
// `t-{tenantId}-…` pour les perso).
// ====================================================================

model Produit {
  id              String           @id @default(uuid())
  tenantId        String?          @map("tenant_id") // null = produit global (read-only)
  categorie       ProduitCategorie
  code            String           @unique
  libelle         String
  fournisseur     String?
  marque          String?
  // Numéro/code officiel (n° swissgranum, n° Mst Agroscope, n° W-OSAV pour
  // les phytos…). Permet la traçabilité réglementaire et la jointure avec
  // les listes officielles lors des futurs imports automatiques.
  numeroOfficiel  String?          @map("numero_officiel")
  // Source du référentiel (ex: "swissgranum 2025", "Agroscope eagff Mst 2025-28",
  // "OSAV PSM 15.04.2026"). Visible utilisateur — exigence OSAV.
  sourceCatalogue String?          @map("source_catalogue")
  // SEMENCE : code espèce qui matche les clés du rule engine
  // (suisse_bilanz.besoin_n_par_culture). Permet à un SEMIS de créer
  // automatiquement la Culture sur la parcelle.
  especeCode      String?          @map("espece_code")
  // ENGRAIS : teneurs N/P/K en kg/100kg de produit (ou kg/100L liquide).
  // Pour les engrais organiques (lisier 4 kg N/m³), utiliser unite = M3
  // ou L et exprimer le taux en kg/100L cohérent (× 1000 pour le m³).
  tauxN           Decimal?         @map("taux_n") @db.Decimal(8, 3)
  tauxP           Decimal?         @map("taux_p") @db.Decimal(8, 3)
  tauxK           Decimal?         @map("taux_k") @db.Decimal(8, 3)
  unite           ProduitUnite     @default(KG)
  // Prix de vente CHF HT par unité — visible des admin uniquement (RBAC :
  // OWNER / COMPTABLE). Les EMPLOYE saisissent le prix sur la ligne de
  // travail si nécessaire, sans voir le prix catalogue ni les marges.
  prixVenteCHF    Decimal?         @map("prix_vente_chf") @db.Decimal(12, 2)
  // Taux de TVA suisse en % (8.1 normal, 2.6 réduit, 3.8 hébergement, 0
  // exonéré). Null = pas configuré, on laisse Odoo prendre son défaut.
  tauxTvaPercent  Decimal?         @map("taux_tva_percent") @db.Decimal(5, 2)
  // Lien Odoo (M6 Phase 2) : product.product.id distant. Renseigné par
  // la sync /api/produits/sync-odoo. Permet le re-sync incrémental
  // (upsert sur (tenantId, odooProductId)).
  odooProductId   Int?             @map("odoo_product_id")
  odooSyncedAt    DateTime?        @map("odoo_synced_at")
  notes           String?
  actif           Boolean          @default(true)
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  tenant        Exploitation?         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  interventions Intervention[]
  planApports   PlanApport[]
  lignesTravail LigneTravailProduit[]

  @@unique([tenantId, odooProductId], name: "tenant_odoo_product_unique")
  @@index([tenantId])
  @@index([categorie])
  @@map("produits")
}

// ====================================================================
// Matériel (prestations facturables) — opération réalisée avec une
// machine sur une parcelle. Mappé Odoo → product.product type="service".
// Utilisé : (1) sur une Intervention pour préciser l'outil utilisé,
// (2) en cas B (parcelle d'un partenaire), pour générer la ligne sale.order
// dans Odoo (quantité = surface en hectares, prix = prixUnitaireCHF).
// ====================================================================
model Materiel {
  id              String            @id @default(uuid())
  // null = catalogue global agri-qodo (read-only). Sinon, matériel custom
  // de l'exploitation (ex tarif négocié, machine spécifique).
  tenantId        String?           @map("tenant_id")
  // Code stable (kebab-case) pour upsert seed + référence externe.
  // Ex : "labour-charrue", "semis-cereale", "ensilage-mais".
  code            String            @unique
  libelle         String
  categorie       MaterielCategorie
  unite           MaterielUnite     @default(HA)
  // Tarif par défaut CHF HT par unité (HA / M3 / T / H / FORFAIT). Modifiable
  // ligne par ligne sur le Travail/Intervention. Null = à saisir au cas par cas.
  prixUnitaireCHF Decimal?          @map("prix_unitaire_chf") @db.Decimal(12, 2)
  // Taux de TVA suisse en % (8.1 normal, 2.6 réduit, 3.8 hébergement, 0
  // exonéré). Null = pas configuré, on laisse Odoo prendre son défaut.
  tauxTvaPercent  Decimal?          @map("taux_tva_percent") @db.Decimal(5, 2)
  // Lien Odoo : product.product de type "service". Renseigné par sync_odoo
  // ou créé automatiquement au 1er push d'une Intervention/Travail
  // utilisant ce matériel.
  odooProductId   Int?              @map("odoo_product_id")
  odooSyncedAt    DateTime?         @map("odoo_synced_at")
  notes           String?
  actif           Boolean           @default(true)
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  tenant        Exploitation?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  interventions Intervention[]

  @@unique([tenantId, odooProductId], name: "tenant_odoo_materiel_unique")
  @@index([tenantId])
  @@index([categorie])
  @@map("materiels")
}

model PartnerLink {
  id              String            @id @default(uuid())
  ownerTenantId   String            @map("owner_tenant_id")
  partnerTenantId String            @map("partner_tenant_id")
  // scope JSON : { parcelles: 'all' | string[], niveau: PartnerLinkLevel }
  scope           Json
  niveau          PartnerLinkLevel
  status          PartnerLinkStatus @default(PENDING)
  grantedAt       DateTime?         @map("granted_at")
  revokedAt       DateTime?         @map("revoked_at")
  // Mapping Odoo : id du res.partner (côté Odoo de l'owner) qui correspond
  // au tenant partenaire. Renseigné lors du 1er push d'un Travail vers Odoo
  // (lookup par nom puis création si absent). Sert à éviter la création de
  // doublons à chaque devis.
  odooPartnerId   Int?              @map("odoo_partner_id")
  createdAt       DateTime          @default(now()) @map("created_at")

  ownerTenant   Exploitation @relation("PartnerLinkOwner", fields: [ownerTenantId], references: [id], onDelete: Cascade)
  partnerTenant Exploitation @relation("PartnerLinkPartner", fields: [partnerTenantId], references: [id], onDelete: Cascade)

  @@unique([ownerTenantId, partnerTenantId])
  @@index([status])
  @@map("partner_links")
}

// ====================================================================
// Travaux facturables (M6 PR-D) — modèle unifié produits + heures
// ====================================================================
//
// Un Travail = un événement complet (mission, prestation, opération
// interne) qui regroupe en un seul endroit :
//   - les PRODUITS consommés (semences, phytos, fournitures…)
//   - les HEURES de travail des employés (timesheet)
//
// Ce design évite la double saisie (cf project_agri_qodo_travaux_timesheet
// en mémoire). Pour la facturation Odoo : 1 sale.order avec lignes
// produits ET lignes services horaires + N analytic lines pour le
// timesheet comptable (PR-E à venir).

enum TravailStatut {
  PLANIFIE       // Sprint 2 : planifié à l'avance, pas encore réalisé
  DRAFT          // brouillon, l'agriculteur saisit
  PENDING_REVIEW // Sprint 2 : employé l'a marqué fait, OWNER doit valider
  VALIDATED      // validé, prêt à facturer
  INVOICED       // poussé vers Odoo (sale.order créé)
  CANCELLED
}

model Travail {
  id           String        @id @default(uuid())
  tenantId     String        @map("tenant_id")
  // Client/partenaire pour qui le travail a été fait. Null = travail
  // interne à l'exploitation (sans facturation client).
  partenaireId String?       @map("partenaire_id")
  // Parcelle concernée (optionnel — un travail peut être hors parcelle,
  // ex maintenance bâtiment, transport).
  parcelleId   String?       @map("parcelle_id")
  // Référence libre (ex "Récolte champ Loup"), affichée dans les listes.
  titre        String
  date         DateTime
  dateDebut    DateTime?     @map("date_debut")
  dateFin      DateTime?     @map("date_fin")
  // Travail interne : pas facturable, pas exporté vers Odoo. Permet de
  // pointer du temps "personnel" (entretien tracteur, formation) sans
  // créer de devis client.
  interne      Boolean       @default(false)
  statut       TravailStatut @default(DRAFT)
  notes        String?
  // Une fois poussé vers Odoo, on garde la trace du sale.order créé pour
  // pouvoir réconcilier (et bloquer la modification).
  odooSaleOrderId Int?       @map("odoo_sale_order_id")
  /// Client Odoo "seul" (res.partner) — utilisé quand le travail s'adresse
  /// à un client qui n'est PAS sur Agri Qodo. Stocke uniquement l'ID Odoo,
  /// pas d'Exploitation ni de PartnerLink créés. Mutuellement exclusif
  /// avec partenaireId : soit l'un, soit l'autre. Décision Fabien
  /// 2026-05-06 : ne plus polluer la liste des Partenaires avec des
  /// shadows pour les clients Odoo "non-agri-qodo".
  odooPartnerId   Int?       @map("odoo_partner_id")
  /// Nom du res.partner Odoo capturé au moment de la sélection (le
  /// picker l'a déjà à portée). Sert à afficher correctement le client
  /// dans /travaux/[id] et les listes sans round-trip Odoo. Reste
  /// indicatif (autorité = Odoo via odooPartnerId), mais évite de
  /// montrer "Client Odoo" générique à l'utilisateur.
  odooPartnerName String?    @map("odoo_partner_name")
  // Pour les travaux interne (interne=true), on ne crée pas de devis
  // mais une project.task avec le détail (heures, employés, parcelle…)
  // dans le chatter Odoo. Sert à tracer côté Odoo sans facturer.
  odooTaskId      Int?       @map("odoo_task_id")
  invoicedAt   DateTime?     @map("invoiced_at")
  /// Étiquette de regroupement libre (cf C2). Pour les travaux pour tiers
  /// ce champ est typiquement obligatoire au form (pré-rempli depuis le
  /// setting tenant defaultProjetTravauxTiersId), pour les travaux
  /// internes il est optionnel. Set null si le projet est supprimé.
  projetId     String?       @map("projet_id")
  // Champs personnalisés tenant (PRD fusion v0.2 §4 q4) — JSON libre pour
  // permettre des extensions sans migration. UI à venir Sprint ultérieur.
  customFields Json?         @map("custom_fields")
  // Sprint 2 fusion-interventions — Planning. datePrevue = date prévue
  // d'exécution (≠ `date` qui est la date réelle quand saisi).
  // assignedToUserId = employé en charge. Statut transitionne PLANIFIE
  // → PENDING_REVIEW (employé) ou VALIDATED (owner) au "Marquer terminé".
  datePrevue       DateTime? @map("date_prevue")
  assignedToUserId String?   @map("assigned_to_user_id")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  tenant     Exploitation  @relation("TravailTenant", fields: [tenantId], references: [id], onDelete: Cascade)
  partenaire Exploitation? @relation("TravailPartenaire", fields: [partenaireId], references: [id], onDelete: SetNull)
  parcelle   Parcelle?     @relation(fields: [parcelleId], references: [id], onDelete: SetNull)
  projet     Projet?       @relation("TravailProjet", fields: [projetId], references: [id], onDelete: SetNull)
  assignedTo User?         @relation("TravailAssignedUser", fields: [assignedToUserId], references: [id], onDelete: SetNull)

  lignesProduit LigneTravailProduit[]
  lignesHeure   LigneTravailHeure[]
  presences     Presence[]

  // Cas B : Intervention saisie chez le client à laquelle ce Travail
  // a été automatiquement rattaché (1-1). Permet de re-pousser le
  // sale.order quand la zone/quantité est modifiée côté client.
  linkedIntervention Intervention? @relation("InterventionTravailLink")

  @@index([tenantId])
  @@index([partenaireId])
  @@index([parcelleId])
  @@index([projetId])
  @@index([statut])
  @@index([date])
  @@map("travaux")
}

model LigneTravailProduit {
  id        String   @id @default(uuid())
  travailId String   @map("travail_id")
  // Référence catalogue (recommandé). Null pour libellé libre.
  produitId String?  @map("produit_id")
  // Libellé affiché (auto-rempli depuis le produit si choisi).
  libelle   String
  quantite  Decimal  @db.Decimal(12, 3)
  unite     String   @default("kg")
  // Prix unitaire CHF HT. Null = ligne non facturable (consommable interne).
  prixUnitaireCHF Decimal? @map("prix_unitaire_chf") @db.Decimal(12, 2)
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")

  travail Travail  @relation(fields: [travailId], references: [id], onDelete: Cascade)
  produit Produit? @relation(fields: [produitId], references: [id], onDelete: SetNull)

  @@index([travailId])
  @@index([produitId])
  @@map("travail_lignes_produit")
}

model LigneTravailHeure {
  id        String  @id @default(uuid())
  travailId String  @map("travail_id")
  // Employé qui a effectué les heures. Référence User (= membership tenant).
  userId    String  @map("user_id")
  // Heures début / fin (optionnel). Si renseignés, dureeMinutes est calculée
  // automatiquement. Sert aussi pour le lien avec la présence (qui a
  // travaillé quand) — cf future intégration timesheet/attendance Odoo.
  heureDebut DateTime? @map("heure_debut")
  heureFin   DateTime? @map("heure_fin")
  // Durée en minutes — plus précis qu'heures décimales pour la saisie au
  // smartphone (pause = 30 min, déplacement = 45 min, etc.).
  dureeMinutes Int  @map("duree_minutes")
  // Taux horaire CHF HT. Null = ligne non facturable (heures internes).
  tauxHoraireCHF Decimal? @map("taux_horaire_chf") @db.Decimal(12, 2)
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")

  travail   Travail    @relation(fields: [travailId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  presences Presence[] // 1-N : présences pointées qui ont généré cette ligne (cas Presence → Travail)

  @@index([travailId])
  @@index([userId])
  @@map("travail_lignes_heure")
}

// ====================================================================
// Présences (pointage employé style qodo-clock)
// ====================================================================
//
// Chaque journée d'un employé se découpe en N Presence (clock-in / clock-out).
// Différentes "natures" couvrent le réel terrain : sur chantier, en
// déplacement, en pause, à un repas extérieur, au bureau.
//
// Lien timesheet : à la fermeture (clockOut), l'employé peut associer la
// Presence à un Travail facturable. Le système génère alors une
// `LigneTravailHeure` rattachée à ce Travail (fini la double saisie heures).
//
// Mobile-first : 1 gros bouton "Pointer entrée" / "Pointer sortie" sur
// /presences. Géolocalisation optionnelle pour traçabilité chantier.

enum PresenceType {
  CHANTIER // travail effectif sur une parcelle/un chantier client
  DEPLACEMENT // route entre 2 chantiers, livraison
  REPAS // pause repas (compté différemment selon convention)
  PAUSE // pause courte (café, météo)
  BUREAU // travail administratif, planification
  AUTRE // formation, médecin, autre absence courte
}

model Presence {
  id         String       @id @default(uuid())
  tenantId   String       @map("tenant_id")
  userId     String       @map("user_id")
  type       PresenceType @default(CHANTIER)
  // Clock-in : début de la présence (= moment du clic "Pointer entrée").
  dateDebut  DateTime     @map("date_debut")
  // Clock-out : null tant que la présence est ouverte. Mis à jour au
  // clic "Pointer sortie" → permet de calculer la durée.
  dateFin    DateTime?    @map("date_fin")
  // Durée en minutes — recalculée par le service à la fermeture pour
  // simplifier les requêtes d'agrégation (timesheet hebdo).
  dureeMinutes Int?       @map("duree_minutes")
  // Lien optionnel vers un Travail facturable. Si renseigné à la
  // fermeture, on génère automatiquement une LigneTravailHeure (cf
  // linkedLigneHeureId). Pour les présences internes (BUREAU, formation),
  // on laisse null.
  travailId  String?      @map("travail_id")
  // LigneTravailHeure générée automatiquement. Null tant que la présence
  // est ouverte ou non rattachée. SetNull si la ligne est supprimée
  // côté Travail (la Presence reste comme historique brut).
  linkedLigneHeureId String?  @unique @map("linked_ligne_heure_id")
  /// True = créée automatiquement depuis une LigneTravailHeure (source
  /// unique heures→présence). Permet de purger/régénérer ces Presences
  /// à chaque PATCH Travail sans toucher aux Presences pointées via
  /// clock-in. False = saisie manuelle ou clock-in.
  autoFromHeures Boolean  @default(false) @map("auto_from_heures")
  // Géolocalisation optionnelle au clock-in (lat/lng WGS84). Sert à
  // valider que l'employé était bien sur la parcelle. Saisie plus tard
  // si l'app mobile la demande.
  latitudeDebut  Decimal?  @map("latitude_debut") @db.Decimal(9, 6)
  longitudeDebut Decimal?  @map("longitude_debut") @db.Decimal(9, 6)
  notes      String?
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  tenant       Exploitation       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  travail      Travail?           @relation(fields: [travailId], references: [id], onDelete: SetNull)
  ligneHeure   LigneTravailHeure? @relation(fields: [linkedLigneHeureId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([userId])
  @@index([dateDebut])
  @@index([travailId])
  @@map("presences")
}

// ====================================================================
// Audit / EditHistory
// ====================================================================

// Trace générique des modifications matérielles sur les entités
// auditables (Travail, Intervention, Presence, etc.). Sert :
// - de base future pour les audit logs LPD/nFADP (Mois 2 backlog),
// - à afficher l'historique d'un enregistrement dans l'UI ("Modifié
//   par X le Y, champ Z passé de A à B").
// On reste sur un format JSONB générique pour ne pas avoir à migrer
// quand on étend l'audit à d'autres entités.
model EditHistory {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  // Type d'entité auditée (ex: "Travail", "Intervention"). Free-form
  // string plutôt qu'un enum pour ne pas forcer une migration à chaque
  // ajout d'entité auditée.
  entityType String   @map("entity_type") @db.VarChar(50)
  entityId   String   @map("entity_id")
  // User qui a fait la modification (peut être un partenaire externe
  // dans le cas B). FK avec onDelete=SetNull pour ne pas perdre
  // l'historique si on supprime un user.
  userId     String?  @map("user_id")
  // Action effectuée : "UPDATE", "VALIDATE", "REJECT", "CANCEL",
  // "DELETE" — extensible.
  action     String   @db.VarChar(20)
  // Diff JSON : { fieldName: { old: any, new: any } }. Null pour les
  // actions sans diff de champ (DELETE, VALIDATE, etc.).
  diff       Json?
  // Métadonnées libres : raison de refus, IP, user-agent, etc.
  meta       Json?
  editedAt   DateTime @default(now()) @map("edited_at")

  tenant Exploitation @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, entityType, entityId])
  @@index([tenantId, editedAt])
  @@map("edit_history")
}
