// Prisma schema — Agri Qodo backend
//
// Source de vérité : docs/SPEC_COMPLETE.md §6 (modèle de données central)
// + §11 (lien partenaire M16).
//
// Toutes les entités métier portent `tenantId` (multi-tenant strict).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

// ====================================================================
// Enums
// ====================================================================

enum Canton {
  VD
  GE
  FR
  NE
  JU
  VS
  BE
  ZH
  AG
  SO
  LU
  TG
  SG
  GR
  TI
  BL
  BS
  SH
  AR
  AI
  GL
  NW
  OW
  SZ
  UR
  ZG
}

enum ZoneAgricole {
  ZA // Zone agricole
  ZP // Zone des prairies
  ZM1 // Zone de montagne I
  ZM2 // Zone de montagne II
  ZM3 // Zone de montagne III
  ZM4 // Zone de montagne IV
  ZE // Zone d'estivage
}

enum InterventionType {
  SEMIS
  FUMURE_ORGANIQUE
  FUMURE_MINERALE
  PHYTO
  RECOLTE
  TRAVAIL_DU_SOL
  IRRIGATION
  AUTRE
}

enum ValidationStatus {
  SELF // Saisie par le tenant propriétaire
  PENDING // Saisie par un partenaire, en attente
  VALIDATED // Validée par le propriétaire
  REJECTED // Refusée par le propriétaire
}

enum AnimalCategorie {
  VACHE_LAITIERE
  GENISSE
  VEAU
  TAUREAU
  BOEUF
  AUTRE_BOVIN
  PORC
  POULET
  AUTRE
}

enum PartnerLinkStatus {
  PENDING
  ACTIVE
  REVOKED
}

enum PartnerLinkLevel {
  LECTURE // Voit les données mais ne saisit rien
  VALIDATION // Saisit, le propriétaire doit valider
  DIRECT // Saisit directement, sans validation
}

enum UserRole {
  OWNER // Chef d'exploitation
  EMPLOYE // Salarié
  COMPTABLE // Accès lecture/compta
  CONSULTANT // Conseiller (Agridea, fiduciaire)
}

enum RuleSetScope {
  GLOBAL // Template universel (OPD-CH-2026, OPD-CH-2026-BIO, …)
  CANTON // Variante cantonale
  TENANT // Override par exploitation
}

// ====================================================================
// Tenant racine + utilisateurs
// ====================================================================

model Exploitation {
  id              String   @id @default(uuid())
  // Code unique format AQ-{canton}-{ufam}-{token4} — voir §6 spec
  code            String   @unique
  nom             String
  canton          Canton
  numeroUfam      String?  @map("numero_ufam") // n° canton/UFAM
  numeroBdta      String?  @map("numero_bdta") // n° d'exploitation BDTA / Identitas
  adresse         String?
  npa             String?
  localite        String?
  emailContact    String?  @map("email_contact")
  telephone       String?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  users           User[]
  parcelles       Parcelle[]
  interventionsOwned   Intervention[] @relation("InterventionOwner")
  interventionsAuthored Intervention[] @relation("InterventionAuthor")
  animaux         Animal[]
  lots            LotAnimal[]
  sortiesSrpa     SortieSrpa[]
  ruleSets        RuleSet[]
  partnerLinksOwned   PartnerLink[] @relation("PartnerLinkOwner")
  partnerLinksPartner PartnerLink[] @relation("PartnerLinkPartner")

  @@map("exploitations")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  prenom       String
  nom          String
  role         UserRole @default(OWNER)
  tenantId     String   @map("tenant_id")
  isActive     Boolean  @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant       Exploitation   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([tenantId])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ====================================================================
// Parcellaire (M1)
// ====================================================================

model Parcelle {
  id                String       @id @default(uuid())
  tenantId          String       @map("tenant_id")
  nom               String
  identifiantCadastral String?   @map("identifiant_cadastral")
  surfaceM2         Decimal      @map("surface_m2") @db.Decimal(12, 2)
  zone              ZoneAgricole
  // Géométrie PostGIS — multipolygone WGS84 (SRID 4326).
  // Prisma ne supporte pas PostGIS nativement, on utilise Unsupported.
  geom              Unsupported("geometry(MultiPolygon, 4326)")?
  notes             String?
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  tenant            Exploitation @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cultures          Culture[]
  interventions     Intervention[]

  @@index([tenantId])
  @@map("parcelles")
}

// ====================================================================
// Cultures / occupations (M1)
// ====================================================================

model Culture {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  parcelleId   String   @map("parcelle_id")
  espece       String   // e.g. "ble_panifiable", "mais_grain", "prairie_temporaire"
  variete      String?
  dateSemis    DateTime? @map("date_semis")
  dateRecolte  DateTime? @map("date_recolte") // récolte effective ou prévue
  campagne     Int      // année de récolte (2026 = récolte 2026)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  parcelle     Parcelle @relation(fields: [parcelleId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([parcelleId])
  @@index([campagne])
  @@map("cultures")
}

// ====================================================================
// Carnet des champs / interventions (M2)
// ====================================================================

model Intervention {
  id              String   @id @default(uuid())
  // UUID généré côté client pour idempotence à la sync
  clientUuid      String   @unique @map("client_uuid")
  ownerTenantId   String   @map("owner_tenant_id")
  authorTenantId  String   @map("author_tenant_id") // peut différer de owner si M16
  parcelleId      String   @map("parcelle_id")
  type            InterventionType
  dateOperation   DateTime @map("date_operation")
  produit         String?  // libellé produit ou code OPPh
  quantite        Decimal? @db.Decimal(12, 3)
  unite           String?  // "kg", "L", "t", "ha"
  notes           String?
  validationStatus ValidationStatus @default(SELF) @map("validation_status")
  validatedAt     DateTime? @map("validated_at")
  rejectedReason  String?   @map("rejected_reason")
  createdAt       DateTime @default(now()) @map("created_at")

  ownerTenant     Exploitation @relation("InterventionOwner", fields: [ownerTenantId], references: [id], onDelete: Cascade)
  authorTenant    Exploitation @relation("InterventionAuthor", fields: [authorTenantId], references: [id], onDelete: Cascade)
  parcelle        Parcelle     @relation(fields: [parcelleId], references: [id], onDelete: Cascade)

  @@index([ownerTenantId])
  @@index([authorTenantId])
  @@index([parcelleId])
  @@index([dateOperation])
  @@index([validationStatus])
  @@map("interventions")
}

// ====================================================================
// Animaux (M4)
// ====================================================================

model Animal {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  numeroBoucle  String?  @unique @map("numero_boucle") // n° BDTA pour bovins
  nom           String?
  categorie     AnimalCategorie
  dateNaissance DateTime? @map("date_naissance")
  lotId         String?  @map("lot_id")
  isActive      Boolean  @default(true) @map("is_active")
  // Verrou optimiste pour résolution de conflits offline
  version       Int      @default(0)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  tenant        Exploitation @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lot           LotAnimal?   @relation(fields: [lotId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([lotId])
  @@map("animaux")
}

model LotAnimal {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  nom         String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant      Exploitation @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  animaux     Animal[]

  @@index([tenantId])
  @@map("lots_animaux")
}

// ====================================================================
// SRPA — Sorties Régulières au Plein Air (M5)
// ====================================================================

model SortieSrpa {
  id            String          @id @default(uuid())
  tenantId      String          @map("tenant_id")
  date          DateTime        @db.Date
  categorie     AnimalCategorie
  nombreAnimaux Int?            @map("nombre_animaux")
  dureeMinutes  Int?            @map("duree_minutes")
  notes         String?
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  tenant        Exploitation @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, date, categorie])
  @@index([tenantId])
  @@index([date])
  @@map("sorties_srpa")
}

// ====================================================================
// Lien partenaire entre exploitations (M16)
// Voir §11 spec.
// ====================================================================

// ====================================================================
// Rule Engine — moteurs de calcul configurables par template / canton
// / tenant (cf ADR-003).
// ====================================================================

model RuleSet {
  id            String       @id @default(uuid())
  name          String       @unique
  description   String?
  scope         RuleSetScope
  tenantId      String?      @map("tenant_id")
  canton        Canton?
  parentId      String?      @map("parent_id")
  isActive      Boolean      @default(true) @map("is_active")
  effectiveFrom DateTime     @default(now()) @map("effective_from")
  effectiveTo   DateTime?    @map("effective_to")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  parent        RuleSet?      @relation("RuleSetParent", fields: [parentId], references: [id], onDelete: SetNull)
  children      RuleSet[]     @relation("RuleSetParent")
  rules         Rule[]
  tenant        Exploitation? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([scope])
  @@index([tenantId])
  @@map("rule_sets")
}

model Rule {
  id          String   @id @default(uuid())
  ruleSetId   String   @map("rule_set_id")
  key         String
  valueJson   Json     @map("value_json")
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  ruleSet     RuleSet  @relation(fields: [ruleSetId], references: [id], onDelete: Cascade)

  @@unique([ruleSetId, key])
  @@index([key])
  @@map("rules")
}

model PartnerLink {
  id              String            @id @default(uuid())
  ownerTenantId   String            @map("owner_tenant_id")
  partnerTenantId String            @map("partner_tenant_id")
  // scope JSON : { parcelles: 'all' | string[], niveau: PartnerLinkLevel }
  scope           Json
  niveau          PartnerLinkLevel
  status          PartnerLinkStatus @default(PENDING)
  grantedAt       DateTime?         @map("granted_at")
  revokedAt       DateTime?         @map("revoked_at")
  createdAt       DateTime          @default(now()) @map("created_at")

  ownerTenant   Exploitation @relation("PartnerLinkOwner", fields: [ownerTenantId], references: [id], onDelete: Cascade)
  partnerTenant Exploitation @relation("PartnerLinkPartner", fields: [partnerTenantId], references: [id], onDelete: Cascade)

  @@unique([ownerTenantId, partnerTenantId])
  @@index([status])
  @@map("partner_links")
}
