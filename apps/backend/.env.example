# --- Database ---
DATABASE_URL=postgresql://agriqodo:agriqodo@localhost:5433/agriqodo_dev?schema=public
DATABASE_URL_TEST=postgresql://agriqodo:agriqodo@localhost:5433/agriqodo_test?schema=public

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Auth (générer avec: openssl rand -hex 64) ---
JWT_SECRET=change-me-in-production-please-use-openssl-rand-hex-64
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-in-production-please-use-openssl-rand-hex-64-different
JWT_REFRESH_EXPIRES_IN=7d

# --- CH-Login (OIDC via Agate, étape ultérieure) ---
CH_LOGIN_ISSUER=
CH_LOGIN_CLIENT_ID=
CH_LOGIN_CLIENT_SECRET=

# --- Odoo connector (étape 6) ---
ODOO_URL=
ODOO_DB=
ODOO_USERNAME=
ODOO_PASSWORD=

# --- Misc ---
NODE_ENV=development
PORT=3001
LOG_LEVEL=debug

# --- OpenTelemetry (optionnel en dev) ---
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=agri-qodo-backend
