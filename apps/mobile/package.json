{
  "name": "@agri-qodo/mobile",
  "version": "0.0.0",
  "private": true,
  "description": "App mobile React Native + Expo d'Agri Qodo",
  "license": "AGPL-3.0-or-later",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "web": "expo start --web",
    "build": "expo export --platform ios --output-dir dist",
    "lint": "eslint app src --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "echo 'tests à venir' && exit 0",
    "clean": "rimraf .expo dist .turbo"
  },
  "dependencies": {
    "@expo/metro-runtime": "~4.0.1",
