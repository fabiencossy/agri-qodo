# Template .env pour production VPS (à copier en .env.production sur le VPS,
# JAMAIS commit avec les vraies valeurs).
#
# Génération des secrets : openssl rand -hex 64

# --- Domaine ---
DOMAIN_API=api.agri.qodo.ch

# --- PostgreSQL ---
POSTGRES_DB=agriqodo
POSTGRES_USER=agriqodo
POSTGRES_PASSWORD=replace-me-strong-password

# --- Auth ---
JWT_SECRET=replace-me-with-openssl-rand-hex-64
JWT_REFRESH_SECRET=replace-me-with-openssl-rand-hex-64-different
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Odoo connector (M6) ---
# Clé maître AES-256-GCM pour chiffrer les API keys Odoo des tenants.
# 32 bytes hex (64 caractères) — générer avec :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Doit rester stable une fois en prod (sinon les API keys déjà chiffrées
# deviennent illisibles).
ODOO_CREDENTIALS_KEY=

# --- Logs ---
LOG_LEVEL=info
