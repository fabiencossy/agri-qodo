# Template .env pour production VPS (à copier en .env.production sur le VPS,
# JAMAIS commit avec les vraies valeurs).
#
# Génération des secrets : openssl rand -hex 64

# --- Domaine ---
DOMAIN_API=api.newagri.qodo.ch

# --- PostgreSQL ---
POSTGRES_DB=agriqodo
POSTGRES_USER=agriqodo
POSTGRES_PASSWORD=replace-me-strong-password

# --- Auth ---
JWT_SECRET=replace-me-with-openssl-rand-hex-64
JWT_REFRESH_SECRET=replace-me-with-openssl-rand-hex-64-different
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Logs ---
LOG_LEVEL=info
