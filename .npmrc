# node-linker=hoisted : recommandation officielle Expo pour les monorepos
# pnpm. Sans ça, Metro (qui ne suit pas le résolveur strict pnpm) échoue
# sur les deps transitives (@babel/runtime, whatwg-fetch, etc.).
# Voir https://docs.expo.dev/guides/monorepos/
node-linker=hoisted

# Redondant mais explicite : assure que les binaires Prisma/etc. ne sont
# pas hoisted aux endroits qui casseraient le strict isolation côté backend.
shamefully-hoist=false
